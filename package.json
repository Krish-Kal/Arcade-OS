{
  "name": "arcade-Kernel",
  "version": "1.0.0",
  "description": "Arcade Kernel - The Ultimate Desktop Gaming & App Launcher",
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron": "wait-on http://localhost:5173 && electron .",
    "start": "concurrently -k \"npm run dev\" \"npm run electron\"",
    "dist": "npm run build && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.383.0",
    "pdfjs-dist": "^5.6.205",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.23.0",
    "systeminformation": "^5.31.5",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^8.2.0",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "vite": "^8.0.8",
    "wait-on": "^7.2.0"
  },
 "build": {
  "appId": "com.arcade.app",
  "productName": "Arcade Kernel",

  "directories": {
    "output": "release"
  },

  "files": [
    "dist/**/*",
    "electron/**/*",
    "public/icons/**/*",
    "package.json"
  ],

  "asar": true,

  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "public/icons/icon.ico"
  },

  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Arcade Kernel"
  },

  "mac": {
    "target": "dmg",
    "icon": "public/icons/icon.icns"
  },

  "linux": {
    "target": "AppImage",
    "icon": "public/icons/icon.png"
  }
}
}